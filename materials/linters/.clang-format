---
BasedOnStyle:    Google

# --- Отступы ---
IndentWidth: 2
TabWidth:    2
UseTab:      Never

# Все виды скобок — без отступа (стиль K&R)
BreakBeforeBraces: Attach

# --- switch / case ---
IndentCaseLabels:        true    # case и default с отступом
IndentCaseBlocks:        false   # блок под case — без доп. отступа

# --- Выравнивание ---
AlignConsecutiveAssignments: true
AlignConsecutiveDeclarations: false
AlignOperands:               true
AlignAfterOpenBracket:       Align

# Перенос выражений после "=" — выравнивать
BreakBeforeBinaryOperators: None
AlignEscapedNewlines:       Left

# Условия после if/while/for при переносе — выравнивать
ContinuationIndentWidth: 4

# --- Привязка * и & ---
PointerAlignment:      Right   # int *p
ReferenceAlignment:    Right   # в C ссылок нет, но опция не помешает
DerivePointerAlignment: false

# --- Прочее (близко к Google) ---
ColumnLimit:                 100
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine:  false
AllowShortBlocksOnASingleLine: Never
BinPackArguments:              true
BinPackParameters:             true